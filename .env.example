# Intent Bridge process and OpenAI-compatible API
INTENT_BRIDGE_LOG_LEVEL=INFO
INTENT_BRIDGE_API_MODEL_NAME=home-intent
# Public root HA can resolve; required when assistant sounds are enabled.
INTENT_BRIDGE_BASE_URL=
INTENT_BRIDGE_TIMEZONE=Europe/London
# General-assistant grounding for local conventions and location-relative questions.
INTENT_BRIDGE_LOCALE=en-GB
INTENT_BRIDGE_LOCATION=United Kingdom
INTENT_BRIDGE_VOICE_RESPONSE_MAX_CHARS=180
INTENT_BRIDGE_VOICE_ACTION_CONFIRMATION=Done.
INTENT_BRIDGE_VOICE_FAILURE_RESPONSE=Sorry, I couldn't handle that request.

# Local OHF/HassIL deterministic voice route
INTENT_BRIDGE_DETERMINISTIC_LANGUAGE=en
# Recursively loaded at startup. A missing directory logs a warning and is ignored.
INTENT_BRIDGE_DETERMINISTIC_CUSTOM_SENTENCES_PATH=./custom_sentences/en
INTENT_BRIDGE_DETERMINISTIC_TIMEOUT_SECONDS=10
INTENT_BRIDGE_DETERMINISTIC_RESPONSE_GRACE_SECONDS=0.75
INTENT_BRIDGE_DETERMINISTIC_DEFAULT_RESPONSE=Done
INTENT_BRIDGE_DETERMINISTIC_MIN_CONFIDENCE=1.0
# Semicolon-separated, case-insensitive phrases.
INTENT_BRIDGE_DETERMINISTIC_ERROR_PHRASES=

# OpenAI-compatible LLM fallback
INTENT_BRIDGE_LLM_ENABLED=true
INTENT_BRIDGE_LLM_AMBIGUOUS_TARGET_FALLBACK_ENABLED=true
INTENT_BRIDGE_LLM_BASE_URL=http://localhost:13305/v1
INTENT_BRIDGE_LLM_API_KEY=not-used
INTENT_BRIDGE_LLM_MODEL=
INTENT_BRIDGE_LLM_MAX_TURNS=6
INTENT_BRIDGE_LLM_TIMEOUT_SECONDS=120
INTENT_BRIDGE_LLM_DATA_RECOVERY_ENABLED=true
INTENT_BRIDGE_LLM_DATA_RECOVERY_MAX_CHARS=16000

# Optional MCP servers exposed directly to the LLM fallback.
INTENT_BRIDGE_MCP_CONFIG_PATH=./mcp.json
INTENT_BRIDGE_MCP_CONNECT_TIMEOUT_SECONDS=30
INTENT_BRIDGE_MCP_CLEANUP_TIMEOUT_SECONDS=10
# Client-side read timeout for MCP requests made by LLM agents.
INTENT_BRIDGE_MCP_CLIENT_SESSION_TIMEOUT_SECONDS=120

# Voice-origin context
INTENT_BRIDGE_VOICE_ORIGIN_ENABLED=true
INTENT_BRIDGE_VOICE_ORIGIN_AREA_BIAS_ENABLED=true
INTENT_BRIDGE_VOICE_ORIGIN_SOFT_RANKING_ENABLED=true
INTENT_BRIDGE_VOICE_ORIGIN_SYSTEM_PROMPT_FALLBACK_ENABLED=true

# Home Assistant direct integration
INTENT_BRIDGE_HA_BASE_URL=http://homeassistant.local:8123
INTENT_BRIDGE_HA_ACCESS_TOKEN=
INTENT_BRIDGE_HA_WS_ENABLED=true
INTENT_BRIDGE_HA_WS_CONNECT_TIMEOUT_SECONDS=20
INTENT_BRIDGE_HA_WS_COMMAND_TIMEOUT_SECONDS=15
INTENT_BRIDGE_HA_WS_RECONNECT_DELAY_SECONDS=2
INTENT_BRIDGE_HA_SERVICE_CACHE_TTL_SECONDS=600
INTENT_BRIDGE_HA_REGISTRY_CACHE_TTL_SECONDS=600
INTENT_BRIDGE_HA_STATE_CONFIRM_TIMEOUT_SECONDS=1
# The deterministic catalog is rebuilt in the background from complete cache copies.
INTENT_BRIDGE_HA_CATALOG_REFRESH_SECONDS=60
INTENT_BRIDGE_HA_CATALOG_EVENT_DEBOUNCE_SECONDS=0.5
INTENT_BRIDGE_HA_CATALOG_MINIMUM_REFRESH_SECONDS=1
INTENT_BRIDGE_HA_SEARCH_DEFAULT_LIMIT=8
INTENT_BRIDGE_HA_SEARCH_MAX_LIMIT=20
INTENT_BRIDGE_HA_SCHEMA_AUTO_REPAIR_ENABLED=true
# Bare names that uniquely resolve to an automation run its actions. Set false
# to retain the former behavior of reporting whether the automation is on.
INTENT_BRIDGE_HA_TRIGGER_DISCOVERED_AUTOMATIONS_ENABLED=true
INTENT_BRIDGE_HA_PENALIZE_INDICATOR_LIGHTS=true
INTENT_BRIDGE_HA_IGNORED_ENTITY_DOMAINS=update
# Comma-separated service names that can return terminal action responses.
INTENT_BRIDGE_HA_STATE_CHANGING_SERVICES=turn_on,turn_off,toggle,open,close,open_cover,close_cover,lock,unlock,set_temperature,set_hvac_mode,set_fan_mode,set_percentage,set_preset_mode,select_option,set_value,set_datetime,set_cover_position,set_position,play_media,media_play,media_pause,media_stop

# Optional advanced Home Assistant MCP specialist
INTENT_BRIDGE_HA_ADVANCED_ENABLED=true
INTENT_BRIDGE_HA_ADVANCED_CONNECT_TIMEOUT_SECONDS=120
INTENT_BRIDGE_HA_ADVANCED_CLEANUP_TIMEOUT_SECONDS=30
INTENT_BRIDGE_HA_ADVANCED_MAX_TURNS=8
INTENT_BRIDGE_HA_ADVANCED_COMMAND=python3
INTENT_BRIDGE_HA_ADVANCED_ARGS=-m uv tool run ha-mcp@latest
INTENT_BRIDGE_HA_ADVANCED_TOOL_SEARCH_ENABLED=true
INTENT_BRIDGE_HA_ADVANCED_TOOL_SEARCH_MAX_RESULTS=5
INTENT_BRIDGE_HA_ADVANCED_PINNED_TOOLS=ha_search,ha_get_state,ha_call_service,ha_get_overview

# Native Music Assistant integration
INTENT_BRIDGE_MA_ENABLED=true
INTENT_BRIDGE_MA_PREFER_NATIVE_PLAYBACK=true
INTENT_BRIDGE_MA_BASE_URL=http://music-assistant.local:8095
INTENT_BRIDGE_MA_ACCESS_TOKEN=
# Format: Office=player-id,Kitchen=other-player-id
INTENT_BRIDGE_MA_AREA_PLAYER_MAP=
INTENT_BRIDGE_MA_CONNECT_TIMEOUT_SECONDS=15
INTENT_BRIDGE_MA_COMMAND_TIMEOUT_SECONDS=20
INTENT_BRIDGE_MA_RECONNECT_DELAY_SECONDS=2
INTENT_BRIDGE_MA_SEARCH_DEFAULT_LIMIT=10
INTENT_BRIDGE_MA_POST_ACTION_SETTLE_SECONDS=0.25
INTENT_BRIDGE_MA_PLAY_ACK_TIMEOUT_SECONDS=2
INTENT_BRIDGE_MA_PLAY_COMPLETION_TIMEOUT_SECONDS=90
INTENT_BRIDGE_MA_FIRST_AUDIO_TIMEOUT_SECONDS=15
INTENT_BRIDGE_MA_FIRST_AUDIO_POLL_SECONDS=0.2
INTENT_BRIDGE_MA_BACKGROUND_TIMEOUT_SECONDS=300
INTENT_BRIDGE_MA_RADIO_SEED_TOP_N=8
INTENT_BRIDGE_MA_RADIO_SEED_STRATEGY=weighted
INTENT_BRIDGE_MA_TERMINAL_ACTIONS_ENABLED=true
INTENT_BRIDGE_MA_REPLAY_GUARD_SECONDS=4

# Assistant feedback (available to any adapter)
INTENT_BRIDGE_ASSISTANT_LED_ENABLED=true
INTENT_BRIDGE_ASSISTANT_LED_DOMAINS=light,switch
INTENT_BRIDGE_ASSISTANT_LED_COLOR=green
INTENT_BRIDGE_ASSISTANT_LED_EFFECT=pulse
INTENT_BRIDGE_ASSISTANT_LED_SOFTWARE_PULSE_ENABLED=true
INTENT_BRIDGE_ASSISTANT_LED_PULSE_INTERVAL_SECONDS=0.7
INTENT_BRIDGE_ASSISTANT_SOUNDS_ENABLED=false

# Conversation memory
INTENT_BRIDGE_CONVERSATION_ENABLED=true
INTENT_BRIDGE_CONVERSATION_HISTORY_TURNS=4
INTENT_BRIDGE_CONVERSATION_TTL_SECONDS=300
INTENT_BRIDGE_CONVERSATION_MAX_SESSIONS=32
